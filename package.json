{
  "name": "triangle-duel",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "bots": "tsx scripts/bot-arena.ts",
    "bot-tune": "tsx scripts/bot-tune.ts",
    "shape-arena": "tsx scripts/shape-arena.ts",
    "verify": "tsx scripts/verify-recording.ts",
    "cross-browser": "npm run build && tsx scripts/cross-browser.ts",
    "relay": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler dev --port 8787",
    "serve": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "relay:smoke": "tsx scripts/relay-smoke.ts",
    "netsim": "tsx scripts/netsim.ts",
    "e2e": "npm run build && tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.21.0",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
