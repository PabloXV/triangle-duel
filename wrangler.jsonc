// Cloudflare config: one Worker serves the game (static files from dist/,
// built by `npm run build`) and the room relay (/api/*, server/).
// Local: `npm run relay` (relay only, for `npm run dev`), or `npm run serve`
// (the production setup: build, then game + relay on http://localhost:8787).
{
  "name": "triangle-duel",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  // On Cloudflare's Git builds this builds the game first (see the script).
  "build": { "command": "node scripts/ci-build.mjs" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the relay's paths run Worker code; everything else is a static file.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are the kind available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
