// Cloudflare config for the room relay (server/). Local dev: `npm run relay`.
{
  "name": "triangle-duel-relay",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are the kind available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
